# Copia este archivo como .env.local y completa los valores.
# En Netlify se configuran en Site configuration › Environment variables.

# Supabase › Project Settings › API (o Data API): URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave publicable (sb_publishable_...). Llega al navegador: es pública por diseño
# y solo da lo que permiten las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Llave secreta (sb_secret_...). SOLO servidor: se usa para crear usuarios y
# restablecer contraseñas. Nunca la pongas en el navegador, en GitHub ni en el chat.
SUPABASE_SECRET_KEY=

# Dirección pública de la aplicación, para los enlaces de recuperación de contraseña
NEXT_PUBLIC_SITE_URL=http://localhost:3000
